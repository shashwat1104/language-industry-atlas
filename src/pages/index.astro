    <script is:inline define:vars={{ books }}>
      // 1. Bookshelf Filter & Search
      const filterBtns = document.querySelectorAll('.filter-btn');
      const bookSlots = document.querySelectorAll('.book-slot');
      const searchInput = document.getElementById('shelf-search-input');
      let currentFilter = 'all';

      function applyShelfFilter() {
        const query = (searchInput.value || '').trim().toLowerCase();
        bookSlots.forEach((slot) => {
          const cat = slot.getAttribute('data-category');
          const text = slot.getAttribute('data-search') || '';
          const matchesCat = currentFilter === 'all' || cat === currentFilter;
          const matchesQuery = !query || text.includes(query);
          slot.style.display = matchesCat && matchesQuery ? 'flex' : 'none';
        });
      }

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          currentFilter = btn.getAttribute('data-filter');
          applyShelfFilter();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', applyShelfFilter);
      }

      // 2. Book Pull-Out Drawer Modal
      const backdrop = document.getElementById('book-drawer-backdrop');
      const closeBtn = document.getElementById('drawer-close-btn');
      const drawerEyebrow = document.getElementById('drawer-eyebrow');
      const drawerTitle = document.getElementById('drawer-title');
      const drawerSummary = document.getElementById('drawer-summary');
      const drawerList = document.getElementById('drawer-chapter-list');
      const drawerPrimaryLink = document.getElementById('drawer-primary-link');

      function openBookDrawer(index) {
        const b = books[index];
        if (!b) return;
        drawerEyebrow.textContent = `VOLUME ${b.num} (${b.roman}) · ${b.layerLabel.toUpperCase()} · AI DISRUPTION ${b.disruption}`;
        drawerTitle.textContent = `Volume ${b.num}: ${b.title} — ${b.subtitle}`;
        drawerSummary.textContent = b.summary;
        drawerPrimaryLink.href = b.link;
        drawerPrimaryLink.textContent = `Open Volume ${b.num} Full Reader →`;

        drawerList.innerHTML = '';
        b.chapters.forEach((ch) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = ch.href;
          a.innerHTML = `<span>${ch.label}</span><span style="font-family:var(--font-mono); font-size:0.78rem; color:var(--accent-emerald);">Open Chapter →</span>`;
          li.appendChild(a);
          drawerList.appendChild(li);
        });

        backdrop.classList.add('open');
        backdrop.setAttribute('aria-hidden', 'false');
      }

      function closeBookDrawer() {
        backdrop.classList.remove('open');
        backdrop.setAttribute('aria-hidden', 'true');
      }

      document.querySelectorAll('.book-card').forEach((card) => {
        card.addEventListener('click', () => {
          const idx = parseInt(card.getAttribute('data-book-index'), 10);
          openBookDrawer(idx);
        });
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            const idx = parseInt(card.getAttribute('data-book-index'), 10);
            openBookDrawer(idx);
          }
        });
      });

      closeBtn.addEventListener('click', closeBookDrawer);
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) closeBookDrawer();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeBookDrawer();
      });

      // 3. Workbench Tabs
      const wbTabs = document.querySelectorAll('.wb-tab');
      const wbPanels = document.querySelectorAll('.wb-panel');
      wbTabs.forEach((t) => {
        t.addEventListener('click', () => {
          wbTabs.forEach((x) => x.classList.remove('active'));
          wbPanels.forEach((p) => p.classList.remove('active'));
          t.classList.add('active');
          document.getElementById(t.getAttribute('data-wb-tab')).classList.add('active');
        });
      });

      // 4. QE / APE Interactive Simulator
      const qePreset = document.getElementById('qe-preset');
      const qeSource = document.getElementById('qe-source');
      const qeMt = document.getElementById('qe-mt');
      const qeGlossary = document.getElementById('qe-glossary');
      const qeScoreVal = document.getElementById('qe-score-val');
      const qeBadge = document.getElementById('qe-decision-badge');
      const qeApeOut = document.getElementById('qe-ape-output');
      const qeChecks = document.getElementById('qe-checks-list');

      const presets = {
        pass: {
          source: 'Export {count} ledger transactions to CSV for fiscal audit.',
          mt: 'Exportieren Sie {count} Hauptbuchtransaktionen als CSV für die Steuerprüfung.',
          glossary: 'ledger=Hauptbuch | fiscal audit=Jahresabschlussprüfung | Tier=2 (B2B SaaS)',
          score: '94.2%',
          color: '#34d399',
          badgeBg: '#064e3b',
          badgeColor: '#6ee7b7',
          badgeText: '✓ SKIP HUMAN REVIEW (AUTO-PUBLISH AFTER APE)',
          ape: 'Exportieren Sie {count} Hauptbuchtransaktionen als CSV für die Jahresabschlussprüfung.',
          checks: [
            '<li style="color:#6ee7b7;">[PASS] Placeholder `{count}` preserved identically in source and target.</li>',
            '<li style="color:#fbbf24;">[APE AUTO-FIX] Enforced TBX term `fiscal audit` → `Jahresabschlussprüfung` (replaced `Steuerprüfung`).</li>',
            '<li style="color:#6ee7b7;">[PASS] German UI expansion (+28%) within 120-char table header threshold.</li>'
          ]
        },
        placeholder: {
          source: 'Click <g id="cta_pay">Charge {amount}</g> to post invoice #{invId}.',
          mt: '<g id="cta_pay">{amount}を充電</g>をクリックして請求書を送信します。',
          glossary: 'Charge (payment)=決済する (NOT 充電=battery charge) | Tier=2 (Fintech UI)',
          score: '61.5% → 93.8% (Post-APE)',
          color: '#fbbf24',
          badgeBg: '#78350f',
          badgeColor: '#fde68a',
          badgeText: '⚡ APE REPAIRED POLYSEMY & MISSING {invId}',
          ape: '<g id="cta_pay">{amount}を決済する</g>をクリックして請求書 #{invId} を計上します。',
          checks: [
            '<li style="color:#f87171;">[CAUGHT DEFECT] Raw MT mistranslated financial `Charge` as EV battery `充電` (polysemy error).</li>',
            '<li style="color:#f87171;">[CAUGHT DEFECT] Raw MT dropped variable `{invId}` from target segment.</li>',
            '<li style="color:#6ee7b7;">[APE REPAIRED] Injected `{invId}` and applied fintech glossary `決済する`, raising QE score to 93.8%.</li>'
          ]
        },
        clinical: {
          source: 'CONTRAINDICATION: Do NOT administer more than 5 mcg/kg in patients with hepatic impairment.',
          mt: 'CONTRAINDICACIÓN: Administrar hasta 5 mg/kg en pacientes con insuficiencia hepática.',
          glossary: 'mcg=microgramos (CRITICAL: never mg) | Tier=1 (Regulated Clinical / IFU)',
          score: '18.4%',
          color: '#f87171',
          badgeBg: '#7f1d1d',
          badgeColor: '#fecaca',
          badgeText: '✕ BLOCKED — TRIGGER MANDATORY HUMAN MEDICAL REVIEW',
          ape: '[BLOCKED FOR HUMAN REVIEW] CONTRAINDICACIÓN: NO administrar más de 5 mcg/kg en pacientes con insuficiencia hepática.',
          checks: [
            '<li style="color:#f87171;">[CRITICAL SAFETY ALERT] Negation reversal detected (`Do NOT administer more than` → `Administrar hasta`).</li>',
            '<li style="color:#f87171;">[CRITICAL DOSAGE ALERT] 1,000x unit error detected (`5 mcg/kg` converted to `5 mg/kg`).</li>',
            '<li style="color:#fbbf24;">[ROUTING ACTION] Tier-1 regulated clinical content automatically routed to ISO 17100 / ISPOR medical reviser.</li>'
          ]
        }
      };

      function updateQeFromCustomInput() {
        const src = qeSource.value;
        const mt = qeMt.value;
        const srcPlaceholders = src.match(/\{[^}]+\}|<[^>]+>/g) || [];
        const missing = srcPlaceholders.filter((p) => !mt.includes(p));
        if (missing.length > 0) {
          qeScoreVal.textContent = '42.0%';
          qeScoreVal.style.color = '#f87171';
          qeBadge.style.background = '#7f1d1d';
          qeBadge.style.color = '#fecaca';
          qeBadge.textContent = '✕ PLACEHOLDER / TAG DEFECT DETECTED';
          qeApeOut.textContent = mt + ' ' + missing.join(' ');
          qeChecks.innerHTML = `<li style="color:#f87171;">[TAG MISMATCH] Missing inline tokens in target: <code>${missing.join(', ')}</code></li>`;
        } else {
          qeScoreVal.textContent = '92.5%';
          qeScoreVal.style.color = '#34d399';
          qeBadge.style.background = '#064e3b';
          qeBadge.style.color = '#6ee7b7';
          qeBadge.textContent = '✓ HIGH CONFIDENCE — SKIP MANUAL REVIEW';
          qeApeOut.textContent = mt;
          qeChecks.innerHTML = `<li style="color:#6ee7b7;">[PASS] All ${srcPlaceholders.length} inline placeholders/tags verified intact.</li>`;
        }
      }

      qePreset.addEventListener('change', () => {
        const p = presets[qePreset.value];
        if (!p) return;
        qeSource.value = p.source;
        qeMt.value = p.mt;
        qeGlossary.value = p.glossary;
        qeScoreVal.textContent = p.score;
        qeScoreVal.style.color = p.color;
        qeBadge.style.background = p.badgeBg;
        qeBadge.style.color = p.badgeColor;
        qeBadge.textContent = p.badgeText;
        qeApeOut.textContent = p.ape;
        qeChecks.innerHTML = p.checks.join('');
      });

      qeSource.addEventListener('input', updateQeFromCustomInput);
      qeMt.addEventListener('input', updateQeFromCustomInput);

      // 5. OpenLoc & QE ROI Calculator
      const roiWords = document.getElementById('roi-words');
      const roiRate = document.getElementById('roi-rate');
      const roiAutoPct = document.getElementById('roi-auto-pct');
      const roiTmsTax = document.getElementById('roi-tms-tax');
      const roiSavingsVal = document.getElementById('roi-savings-val');
      const roiTradCost = document.getElementById('roi-trad-cost');
      const roiModernCost = document.getElementById('roi-modern-cost');
      const roiAutoWords = document.getElementById('roi-auto-words');

      function recalcRoi() {
        const words = parseFloat(roiWords.value) || 0;
        const rate = parseFloat(roiRate.value) || 0;
        const autoPct = Math.min(99, Math.max(0, parseFloat(roiAutoPct.value) || 0)) / 100;
        const tmsTax = parseFloat(roiTmsTax.value) || 0;

        const tradTotal = words * rate + tmsTax;
        const automatedWords = Math.round(words * autoPct);
        const humanReviewedWords = words - automatedWords;
        // Outcome-based AI QE/APE cost ~ $0.008/word + human review on remaining %
        const aiVerificationCost = words * 0.008;
        const modernTotal = humanReviewedWords * rate + aiVerificationCost;
        const savings = Math.max(0, tradTotal - modernTotal);

        roiSavingsVal.textContent = '$' + Math.round(savings).toLocaleString() + ' / yr';
        roiTradCost.textContent = '$' + Math.round(tradTotal).toLocaleString() + ' / yr';
        roiModernCost.textContent = '$' + Math.round(modernTotal).toLocaleString() + ' / yr';
        roiAutoWords.textContent = automatedWords.toLocaleString() + ' words (' + Math.round(autoPct * 100) + '%)';
      }

      [roiWords, roiRate, roiAutoPct, roiTmsTax].forEach((el) => el.addEventListener('input', recalcRoi));
      recalcRoi();

      // 6. i18n Linter
      const lintSource = document.getElementById('lint-source');
      const lintTarget = document.getElementById('lint-target');
      const lintStatusVal = document.getElementById('lint-status-val');
      const lintResultsList = document.getElementById('lint-results-list');

      function runLinter() {
        const src = lintSource.value;
        const tgt = lintTarget.value;
        const issues = [];
        const passes = [];

        // Extract simple {var} and XML tags
        const srcTags = src.match(/<\/?[a-zA-Z0-9_]+[^>]*>/g) || [];
        const missingTags = srcTags.filter((tag) => !tgt.includes(tag));
        if (missingTags.length > 0) {
          issues.push(`[BROKEN XML/XLIFF TAG] Missing tag(s) in target: ${missingTags.join(' ')}`);
        } else if (srcTags.length > 0) {
          passes.push(`[PASS] All ${srcTags.length} inline XLIFF/HTML tags preserved.`);
        }

        const srcVars = Array.from(src.matchAll(/\{([a-zA-Z0-9_]+)/g), (m) => m[1]);
        const missingVars = srcVars.filter((v) => !tgt.includes('{' + v));
        if (missingVars.length > 0) {
          issues.push('[BROKEN ICU VARIABLE] Variable(s) missing in target: ' + missingVars.join(', '));
        } else if (srcVars.length > 0) {
          passes.push('[PASS] All ICU variables (' + srcVars.join(', ') + ') present in target.');
        }

        const expansion = src.length > 0 ? Math.round(((tgt.length - src.length) / src.length) * 100) : 0;
        if (expansion > 35) {
          issues.push(`[UI OVERFLOW WARNING] Target expands source length by +${expansion}% (exceeds 35% mobile button threshold).`);
        } else {
          passes.push(`[PASS] Character length delta: ${expansion >= 0 ? '+' : ''}${expansion}% (safe UI bounds).`);
        }

        if (issues.length > 0) {
          lintStatusVal.textContent = `FAIL (${issues.length} Defect${issues.length > 1 ? 's' : ''})`;
          lintStatusVal.style.color = '#f87171';
        } else {
          lintStatusVal.textContent = 'PASS (0 Defects)';
          lintStatusVal.style.color = '#34d399';
        }

        lintResultsList.innerHTML =
          issues.map((i) => `<li style="color:#f87171;">${i}</li>`).join('') +
          passes.map((p) => `<li style="color:#6ee7b7;">${p}</li>`).join('');
      }

      lintSource.addEventListener('input', runLinter);
      lintTarget.addEventListener('input', runLinter);
      runLinter();

      // 7. Database Explorer Tabs
      const dbTabs = document.querySelectorAll('.db-tab');
      const dbPanels = document.querySelectorAll('.db-panel');
      dbTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          dbTabs.forEach((t) => t.classList.remove('active'));
          dbPanels.forEach((p) => p.classList.remove('active'));
          tab.classList.add('active');
          document.getElementById(tab.getAttribute('data-db-tab')).classList.add('active');
        });
      });
    </script>
  </body>
</html>
