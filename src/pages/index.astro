    <footer>
      <div class="container footer-inner">
        <div>
          <strong>The Complete Language Industry Atlas</strong> · Authored by Shashwat · Hosted at <code>language.shashwat.wtf</code>
        </div>
        <div style="display:flex; gap:1.25rem;">
          <a href="/00-architecture/01-master-atlas/" style="color:var(--ink-primary);">Master Atlas</a>
          <a href="/databases/" style="color:var(--ink-primary);">All 11 Databases</a>
          <a href="/19-volumes/ch01-modelfront-openloc-blueprint/" style="color:var(--ink-primary);">ModelFront / OpenLoc Playbook</a>
          <a href="https://github.com/shashwat1104/language-industry-atlas" target="_blank" rel="noopener" style="color:var(--ink-primary);">GitHub Repo</a>
        </div>
      </div>
